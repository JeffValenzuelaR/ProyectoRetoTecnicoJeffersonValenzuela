# URL del EventService. El frontend pide su propio token JWT a POST /auth/token
# al arrancar y lo renueva solo antes de que expire: no hay que pegar tokens a mano.
VITE_API_URL=http://localhost:8090

# Credenciales del endpoint de demo (opcional; estos son los valores por defecto).
# VITE_DEMO_USERNAME=admin
# VITE_DEMO_ROLE=Admin

# Override opcional: si defines un token aqui, se usa tal cual y NO se pide a /auth/token.
# VITE_DEMO_TOKEN=
